  "verification_source_text": "import Mathlib\n\nnamespace Nl2LeanExpected\ntheorem final_dev_0047 (a b c : Int) (h1 : a ≤ b) (h2 : b ≤ c) : a ≤ c := by sorry\nend Nl2LeanExpected\n\nnamespace Nl2LeanCandidate\ntheorem final_dev_0047 (a b c : Int) (h1 : a ≤ b) (h2 : b ≤ c) : a ≤ c := by\n  linarith\nend Nl2LeanCandidate\n\nexample : @Nl2LeanExpected.final_dev_0047 = @Nl2LeanCandidate.final_dev_0047 := by\n  exact Subsingleton.elim _ _\n#print axioms Nl2LeanCandidate.final_dev_0047\n\nrun_cmd do\n  let expectedInfo ← Lean.getConstInfo `Nl2LeanExpected.final_dev_0047\n  let candidateInfo ← Lean.getConstInfo `Nl2LeanCandidate.final_dev_0047\n  unless expectedInfo.levelParams.length == candidateInfo.levelParams.length do\n    throwError \"Fixed theorem universe-parameter arity mismatch\"\n  let candidateType := candidateInfo.type.instantiateLevelParams candidateInfo.levelParams (expectedInfo.levelParams.map Lean.Level.param)\n  Lean.Elab.Command.liftTermElabM do\n    unless (← Lean.Meta.isDefEq expectedInfo.type candidateType) do\n      throwError \"Fixed theorem closed declaration types differ\"\n"
