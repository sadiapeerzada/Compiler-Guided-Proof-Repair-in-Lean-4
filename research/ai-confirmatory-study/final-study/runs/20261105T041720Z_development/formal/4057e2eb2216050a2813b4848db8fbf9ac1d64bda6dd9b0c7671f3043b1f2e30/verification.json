  "verification_source_text": "import Mathlib\n\nnamespace Nl2LeanExpected\ntheorem final_dev_0194 (a b : Int) : (a + b)^3 - a^3 - b^3 = 3 * a * b * (a + b) := by sorry\nend Nl2LeanExpected\n\nnamespace Nl2LeanCandidate\ntheorem final_dev_0194 (a b : Int) : (a + b)^3 - a^3 - b^3 = 3 * a * b * (a + b) := by\n  ring\nend Nl2LeanCandidate\n\nexample : @Nl2LeanExpected.final_dev_0194 = @Nl2LeanCandidate.final_dev_0194 := by\n  exact Subsingleton.elim _ _\n#print axioms Nl2LeanCandidate.final_dev_0194\n\nrun_cmd do\n  let expectedInfo ← Lean.getConstInfo `Nl2LeanExpected.final_dev_0194\n  let candidateInfo ← Lean.getConstInfo `Nl2LeanCandidate.final_dev_0194\n  unless expectedInfo.levelParams.length == candidateInfo.levelParams.length do\n    throwError \"Fixed theorem universe-parameter arity mismatch\"\n  let candidateType := candidateInfo.type.instantiateLevelParams candidateInfo.levelParams (expectedInfo.levelParams.map Lean.Level.param)\n  Lean.Elab.Command.liftTermElabM do\n    unless (← Lean.Meta.isDefEq expectedInfo.type candidateType) do\n      throwError \"Fixed theorem closed declaration types differ\"\n"
